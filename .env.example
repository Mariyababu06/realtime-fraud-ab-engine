# Copy to .env (or run `make env` to generate strong secrets). .env is git-ignored. Never commit real secrets.

# --- ClickHouse ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=fraud
CLICKHOUSE_ADMIN_USER=admin
CLICKHOUSE_ADMIN_PASSWORD=change-me-admin
CLICKHOUSE_PIPELINE_USER=pipeline_user
CLICKHOUSE_PIPELINE_PASSWORD=change-me-pipeline
CLICKHOUSE_ANALYST_USER=analyst_user
CLICKHOUSE_ANALYST_PASSWORD=change-me-analyst

# --- Privacy / experiment ---
PII_SALT=change-me-pii-salt
EXPERIMENT_SALT=exp-fraud-rules-v1
AB_SPLIT_A=50

# --- Kafka (host-side address; containers override to kafka:9092) ---
KAFKA_BOOTSTRAP=localhost:29092
KAFKA_TOPIC_RAW=transactions.raw
KAFKA_TOPIC_DLQ=transactions.dlq
KAFKA_GROUP=fraud-scorer

# --- Processing / logging ---
BATCH_SIZE=500
LATENCY_SLA_MS=100
LOG_LEVEL=INFO
LOG_FORMAT=json
